{
	admin off
}

:80 {
	root * /usr/share/caddy
	encode gzip

	# JSON access log read by Orbit for traffic stats (no IPs are stored by Orbit)
	log {
		output file /logs/access.log {
			roll_size 20MiB
			roll_keep 3
			mode 0644
		}
		format json
	}

	# common exploit scans: answer 404 immediately (logged, counted by Orbit as probing)
	@probe path /wp-* /.env* /.git* *.php /cgi-bin/* /phpmyadmin* /vendor/* /boaform/* /actuator/* /.aws/* /admin*
	respond @probe 404

	# Price data API: only RapidAPI may call it (it adds the proxy secret header). Anything else gets 403,
	# so the paid data can't be pulled for free around RapidAPI. The files only exist once a secret is configured.
	@api_denied {
		path /api/*
		not header X-RapidAPI-Proxy-Secret {$RAPIDAPI_PROXY_SECRET:unset-no-api}
	}
	respond @api_denied "API access is through RapidAPI" 403
	@api path /api/*
	header @api Cache-Control "no-store"

	# affiliate click beacon from the site's "View" buttons
	@beacon path /c
	respond @beacon 204

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
