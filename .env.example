# Copy to .env on the Pi (chmod 600). Never commit .env.

# eBay Developer Program -> Application Keys -> Production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# eBay Partner Network campaign id (affiliate links). Leave blank until approved.
EPN_CAMPAIGN_ID=
EPN_REFERENCE_ID=site

# Where the database lives (put it on the Seagate once mounted, e.g. /mnt/seagate/gpu-prices)
DATA_DIR=/home/pi/gpu-prices/data

SITE_NAME=Used Tech Prices
SITE_URL=https://micahbyrnes00-svg.github.io/gpu-prices

# AI summaries: command that reads a prompt on stdin. "claude -p" uses your Claude Pro login.
# Use "gemini -p" for Gemini CLI, or leave empty for built-in template text.
AI_CMD=claude -p
AI_REFRESH_DAYS=7

# Money extras (all optional)
# Amazon Associates tracking id, e.g. yourname-20
AMAZON_TAG=
# ca-pub-... after Google AdSense approval (needs your own domain)
ADSENSE_CLIENT=
# Discord channel webhook, set with: bash p.sh discord
DISCORD_WEBHOOK=
# Shown on the privacy page
CONTACT_EMAIL=
# Newsletter embed form action for price-drop emails (e.g. https://buttondown.com/api/emails/embed-subscribe/YOURNAME)
NEWSLETTER_URL=
# Public Discord invite code (the part after discord.gg/), shown as "Join the deals Discord" on the site
DISCORD_INVITE=
# Optional per-channel webhooks (fall back to DISCORD_WEBHOOK); paste them in Orbit > Settings > Integrations
DISCORD_WEBHOOK_GPU=
DISCORD_WEBHOOK_CPU=
DISCORD_WEBHOOK_RAMSSD=
DISCORD_WEBHOOK_MONITOR=
DISCORD_WEBHOOK_CONSOLE=
DISCORD_WEBHOOK_PHONE=
DISCORD_WEBHOOK_REPORT=

# Tailscale admin API access token for Orbit's Tailnet panel (client updates, key expiry, device approval).
# Optional; set with: bash p.sh tsapi   (or paste it in Orbit > Network > Tailnet)
TAILSCALE_API_KEY=
# Tailnet name for the API; "-" means the token's default tailnet
TAILSCALE_TAILNET=-
